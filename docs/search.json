---
layout: null
---
{% assign searchable_pages = site.pages | where: "layout", "default" %}
{% assign searchable_items = site.posts | concat: searchable_pages | concat: site.projects %}
[
  {% assign first_search_entry = true %}
  {% for item in searchable_items %}
    {% assign include_search_entry = true %}
    {% if item.name == "404.html" %}
      {% assign include_search_entry = false %}
    {% endif %}
    {% if item.search == false %}
      {% assign include_search_entry = false %}
    {% endif %}
    {% if include_search_entry %}
      {% unless first_search_entry %},{% endunless %}
    {
      "title": {{ item.title | default: site.title | jsonify }},
      "url": {% if item.collection == "projects" %}{{ '/projects/' | relative_url | jsonify }}{% else %}{{ item.url | relative_url | jsonify }}{% endif %},
      "content": {{ item.content | strip_html | normalize_whitespace | jsonify }},
      "tags": {{ item.tags | join: " " | jsonify }},
      "type": {% if item.collection == "posts" %}"Blog"{% elsif item.collection == "projects" %}"Project"{% else %}"Page"{% endif %}
    }
      {% assign first_search_entry = false %}
    {% endif %}
  {% endfor %}
]
